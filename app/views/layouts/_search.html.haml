= form_tag(search_dashboard_path, {method: :get, class: "filters", data: {controller: "search"}}) do
  #search.search
    %i.fal.fa-fw.fa-search
    = search_field_tag :query, params[:query], placeholder: t(".search")
.login-button
  - if current_user
    = link_to current_user_profile_path do
      %i.fal.fa-fw.fa-id-card-alt{ title: t(".my_profile") }
  - else
    = link_to new_user_session_path do
      %i.fal.fa-fw.fa-user{ title: t(".sign_in") }
