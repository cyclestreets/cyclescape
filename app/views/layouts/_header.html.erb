<div data-controller="sidebar-nav" data-action="click@window->sidebar-nav#closeOnClick keydown.esc@window->sidebar-nav#closeNav">
  <div id="shade" data-sidebar-nav-target="shade">
    <i class="far fa-times-circle close"></i>
  </div>
  <div id="top-menu">
    <%= link_to root_path, class: "unstyled" do %>
      <%= image_tag("new-ui/cyclescape-icon.png", class: "mobile_logo") %>
      <h1><%= @site_config.application_name %></h1>
    <% end %>
  </div>
  <button id="hamburger" data-action="sidebar-nav#openNav"><i class="fas fa-fw fa-bars"></i></button>
  <nav class="sidebar-nav" data-sidebar-nav-target="sidebarNav">
    <div class="title padding">
      <%= link_to root_path, class: "unstyled" do %>
        <%= image_tag("new-ui/cyclescape-icon.png", class: "mobile_logo") %>
        <h1><%= @site_config.application_name %></h1>
      <% end %>
      <% if current_user && defined?(current_group) && current_group %>
        <%= link_to root_path, class: "unstyled group" do %>
          <p><%= current_group.name %></p>
        <% end %>
      <% end %>
    </div>
    <ul class="padding">
      <%= link_to threads_path, data: bs_popover(content: t(".threads_tooltip")) do %>
        <li class="<%= class_names(active: request_path.start_with?("threads")) %>"><i class="fas fa-fw fa-microphone"></i><%= t(".threads") %></li>
      <% end %>
      <%= link_to issues_path, data: bs_popover(content: t(".issues_tooltip")) do %>
        <li class="<%= class_names(active: request_path.start_with?("issues")) %>"><i class="fas fa-fw fa-hashtag"></i><%= t(".issues") %></li>
      <% end %>
      <hr>
      <%= link_to library_path, data: bs_popover(content: t(".library_tooltip")) do %>
        <li class="<%= class_names(active: request_path.start_with?("library")) %>"><i class="fas fa-fw fa-book-open"></i><%= t(".library") %></li>
      <% end %>
      <% if current_user %>
        <%= link_to planning_applications_path do %>
          <li class="<%= class_names(active: request_path.start_with?("planning_applications")) %>"><i class="fas fa-fw fa-sign"></i><%= t(".planning_applications") %></li>
        <% end %>
      <% end %>
      <%= link_to tags_path, data: bs_popover(content: t(".tags_tooltip")) do %>
        <li class="<%= class_names(active: request_path.start_with?("tags")) %>"><i class="fas fa-fw fa-tags"></i><%= t(".tags") %></li>
      <% end %>
      <hr>
    </ul>
    <ul class="padding bottom">
      <% if current_user %>
        <% other_groups = current_user.groups %>
        <% other_groups = other_groups.where.not(id: current_group.id) if defined?(current_group) && current_group %>
        <% if other_groups.exists? %>
          <% group_links = safe_join(other_groups.map { |group| tag.li(link_to_group_home(group)) }) %>
          <%= tag.li id: "group-popover", data: bs_popover(content: tag.ul(group_links, class: "popover-group"), html: true, trigger: "click").merge(sidebar_nav_target: "groupPopover") do %><i class="fas fa-fw fa-users"></i><%= t(".group_selector") %><% end %>
        <% end %>

        <% if defined?(current_group) && current_group && policy(GroupMembershipRequest.new(group: current_group)).index? %>
          <%= link_to group_membership_requests_path(current_group) do %>
            <li><i class="fas fa-fw fa-users-cog"></i><%= t(".group_management") %></li>
          <% end %>
        <% end %>
        <%= link_to user_private_messages_path(current_user) do %>
          <li data-controller="pm-count"><i class="fas fa-fw fa-envelope"><span class="private-message-counter" data-pm-count-target="count" hidden></span></i><%= t(".private_messages") %></li>
        <% end %>
        <%= link_to current_user_profile_path do %>
          <li><i class="fas fa-fw fa-id-card-alt"></i><%= t(".my_profile") %></li>
        <% end %>
        <% if current_user.admin? %>
          <%= link_to admin_home_path, data: bs_popover(content: t(".admin_tooltip")) do %>
            <li><i class="fas fa-fw fa-user-shield"></i><%= t(".admin") %></li>
          <% end %>
        <% end %>
        <%= link_to destroy_user_session_path, method: :delete do %>
          <li><i class="fas fa-fw fa-sign-out"></i><%= t(".sign_out") %></li>
        <% end %>
      <% else %>
        <%= link_to new_user_session_path do %>
          <li><i class="fas fa-fw fa-user"></i><%= t(".sign_in") %></li>
        <% end %>
        <%= link_to new_user_registration_path do %>
          <li><i class="fas fa-fw fa-user-plus"></i><%= t(".sign_up") %></li>
        <% end %>
      <% end %>
      <%= link_to new_site_comment_path do %>
        <li><i class="fas fa-fw fa-hands-helping"></i><%= t(".feedback") %></li>
      <% end %>
    </ul>
  </nav>
</div>

<div id= 'flash'>
  <%= render "layouts/flash" %>
</div>

<%= render "layouts/search" %>
