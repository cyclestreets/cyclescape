%section.threads
  .title-wrapper
    .section-title
      %i{class: "fas fa-fw fa-hashtag"}
      %h1= t ".title"
      %br
  .content-wrapper
    .main-content
      %p= t ".title_introduction", class: "clearleft"
      = link_to new_issue_path, class: "float-right" do
        %button.primary
          = t(".new_issue")
          %i{class: "fas fa-fw fa-hashtag"}
      - if current_group
        %p= t ".list_introduction_groupwise_html", area_of_group_link: link_to(t(".area_of_group", group_name: current_group.name), root_path)
    .side-content
  %hr
  .content-wrapper
    .show-side-content
      %i{class: "fas fa-fw fa-filter"}
    .main-content
      #issue-list-tabs
        %ul.tabs.with-history.ios-segmented-control.adjustable-icons.small
          %li= link_to t(".list_tab"), "#list-pane", class: "list option"
          %li= link_to t(".map_tab"), "#map-pane", class: "map-pin option"
          %li= link_to t(".popular_tab"), "#popular-pane", class: "list option"
        .panes
          #list-pane.pane
            = paginate @issues
            .clear
            %ul.issue-list
              - if @issues.empty?
                = t(".no_results_found")
              = render partial: "compact", collection: @issues, as: :issue
            - if @issues.respond_to?(:total_pages)
              = paginate @issues
          #map-pane.pane
            %p= t ".map_introduction"
            = render "all_map"
          #popular-pane.pane
            %p= t ".popular_introduction"
            %ul.issue-list
              - if @popular_issues.empty?
                = t(".no_popular_issues")
              = render partial: "compact", collection: @popular_issues, as: :issue, locals: {prefix: "popular"}
            - if @popular_issues.respond_to?(:total_pages)
              = paginate @popular_issues, param_name: :pop_issues_page, params: {anchor: 'popular-pane'}
    .side-content
