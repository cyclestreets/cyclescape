%section.threads
  .title-wrapper
    .section-title
      %i{class: "fas fa-fw fa-microphone"}
      %h1= t ".title", group: @group.name
      %br
      - # = link_to new_thread_path do
      - #   %button.primary
      - #     = t(".new_thread")
      - #     %i{class: "fas fa-fw fa-comment-alt-plus"}
  .content-wrapper
    .show-side-content
      = t ".filter_items"
      %i{class: "fas fa-fw fa-filter"}
    .main-content
      - if current_user
        = form_with method: :get, data: { turbo_frame: "threads_frame", controller: "threads", action: "change->threads#saveState" }, local: false, class: "ios-segmented-control adjustable-icons small" do
          %span.selection{ data: { threads_target: "selection" } }
          .option{ title: t(".my_threads_description") }
            - mine_checked = ["mine", nil].include?(params[:view])
            = radio_button_tag "view", "mine", mine_checked, data: { threads_target: "option" }
            = label_tag "view_mine" do
              %span.fas.fa-seedling{ data: { text: t(".my_threads"), threads_target: "label" } }
                = t(".my_threads")

          %div.option{ title: t(".all_threads") }
            = radio_button_tag "view", "all", params[:view] == "all", data: { threads_target: "option" }

            = label_tag "view_all" do
              %span.fas.fa-globe-europe{ data: { text: t(".all"), threads_target: "label" } }
                = t(".all")

          %div.option{title: t(".general_threads")}
            = radio_button_tag "view", "general", params[:view] == "general", data: { threads_target: "option" }
            = label_tag "view_general" do
              %span.fas.fa-bullhorn{ data: {text: t(".general_threads") } }
                = t(".general_threads")

          %div.option{ title: t(".favourites") }
            = radio_button_tag "view", "favourites", params[:view] == "favourites", data: { threads_target: "option" }
            = label_tag "view_favourites" do
              %span.fas.fa-star{ data: { text: t(".favourites"), threads_target: "label" } }
                = t(".favourites")

          %div.option{ title: t(".popular") }
            = radio_button_tag "view", "popular", params[:view] == "popular", data: { threads_target: "option" }
            = label_tag "view_popular" do
              %span.fas.fa-fire-alt{ data: { text: t(".popular"), threads_target: "label" } }
                = t(".popular")

          %div.option{title: t(".deadlines_description")}
            = radio_button_tag "view", "deadlines", params[:view] == "deadlines", data: { threads_target: "option" }
            = label_tag "view_deadlines" do
              %span.fas.fa-calendar-star{data: {text: t(".deadlines"), threads_target: "label" } }
                = t ".deadlines"

      %ul.discussions
        - intro = capture do
          - if params[:view] == "general"
            %p= t ".general_threads_description"
            = link_to new_thread_path, target: "_top" do
              %button.primary
                = t(".new_group_thread")
                %i{class: "fas fa-fw fa-comment-alt-plus"}

            %hr
          - else
            %p= t ".threads_explanation_html", issues_link: link_to(t(".issues"), issues_path)
            %p= t ".issue_threads_description", group_name: @group.name
            %hr
        = render "shared/message_threads_list_frame", threads: @threads, intro: intro
    .side-content
