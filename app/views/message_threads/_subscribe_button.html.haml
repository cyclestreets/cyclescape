- frame_id = "thread_subscription_#{thread.id}"
= turbo_frame_tag frame_id do
  - if signed_in?
    - if current_user.subscribed_to_thread?(thread, all_subscriptions: @user_subscriptions)
      - subscription = current_user.thread_subscriptions.to(thread)
      = form_with model: subscription,
        url: thread_subscription_path(thread, subscription),
        method: :delete,
        data: { turbo_frame: frame_id },
        class: "unsubscribe-form" do |f|
        = f.submit label: :delete, class: "btn-grey btn-unsubscribe"
    - else
      = form_with model: ThreadSubscription.new, url: thread_subscriptions_path(thread_id: thread), data: { turbo_frame: frame_id } do |f|
        = f.submit
