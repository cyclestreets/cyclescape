- committee = committee_members.include?(user)
- popover_data = ''
- popover_content = []
- popover_content.push("<i class='far fa-users'></i> Committee") if committee
- popover_content.push("<i class='far fa-user-crown'></i> Discussion leader") if leading
- popover_data = bs_popover(content: popover_content.to_sentence) if popover_content.present?
%li{data: popover_data}
  - if policy(user).view_profile?
    = link_to user_profile_path(user), class: "d-flex align-items-start" do
      .avatar.flex-shrink-0
        - if policy(user).view_profile? && user.profile.picture
          = image_tag user.profile.picture_thumbnail.url
      .flex-fill
        = user.name
        - if leading
          %i{class: "fas fa-fw fa-user-crown"}
        - if committee
          %i{class: "fas fa-fw fa-users"}
  - else
    %a.d-flex.align-items-start
      .avatar.flex-shrink-0
        - if policy(user).view_profile? && user.profile.picture
          = image_tag user.profile.picture_thumbnail.url
      .flex-fill
        = user.display_name_or_anon
        - if leading
          %i{class: "fas fa-fw fa-user-crown"}
        - if committee
          %i{class: "fas fa-fw fa-users"}

