.index
  .title-wrapper
    .section-title
      %div= image_tag "new-ui/cyclescape-icon.png"
      %div
        %h4 welcome to
        %br/
        %h1 cyclescape
  .content-wrapper
    .main-content.full-screen
      .jumbotron
        %p.description
          Cyclescape is an online campaigning toolkit for people working for better
          cycling across the UK.
        %form
          %input#groups{:placeholder => "Search for groups local to you…", :type => "search"}/
      .flex.action-buttons
        = link_to new_issue_path, class: "action" do
          .icon
            %i.fad.fa-fw.fa-lightbulb
          .text
            %h2 Submit an idea or issue
            %p.description
              Submit an issue to the local cycle campaign. No registration
              necessary.
        = link_to threads_path, class: "action" do
          .icon
            %i.fad.fa-fw.fa-rocket
          .text
            %h2 Browse discussions
            %p.description
              There are new discussions in your area. See what’s going on!
        = link_to new_user_registration_path, class: "action" do
          .icon
            %i.fad.fa-fw.fa-user-crown
          .text
            %h2 Create account
            %p.description
              Join hundreds of other people and get involved in your local
              community.
      .tags
        = link_to tags_path do
          %h2
            %i.fas.fa-fw.fa-hashtag
            Top topics
        %ul.tags
          - @tags.each do |tag|
            %li= link_to tag.name, tag_path(tag)
  = image_tag "new-ui/index-background.jpg", class: "flow"
