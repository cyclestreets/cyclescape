%li
  .disccusion-item
    .content
      - link_class = (@unviewed_thread_ids.include?(thread.id) ? "new primary-link" : "primary-link")
      %h3.drop-cap{class: thread.icon_class, data: {'thread-id' => thread.id}}
        = link_to_if policy(thread).show?, thread_display_title(thread), thread_path(thread), class: link_class, target: "_top"
      - if thread.group
        %p
          = link_to_profile(thread.group, target: "_top")
      - if policy(thread).show? && thread.issue
        %br
        = t ".discussion_on_issue"
        = link_to thread.issue.title, issue_path(thread.issue)
      %div
        %p{class: "italic created-by-details"}
          - latest_activity = @latest_activity.find { |m| m.thread_id == thread.id }
          - if policy(latest_activity.created_by.profile).show?
            = link_to_profile(latest_activity.created_by, target: "_top")
          - else
            = latest_activity.created_by.display_name_or_anon
          = t ".posted_at"
          = time_tag_with_title(latest_activity.updated_at)
      %ul{class: "tags"}
        - thread.tags.each do |tag|
          %li{class: "tag"}= link_to tag.name, tag_path(tag), target: "_top"
    = render 'message_threads/subscribe_button', thread: thread
    = render "message_thread/user_favourites/form", thread: thread, cached: true
    .permissions= thread_type(thread)
