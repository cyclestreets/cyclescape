%section.content-no-sidebar
  .title-wrapper
    .section-title
      %i{class: "fas fa-fw fa-tags"}
      %h1= Tag.model_name.human.pluralize

#tagcloud

:javascript
  $("#tagcloud").jQCloud([ #{safe_join(@tags.map { |tag| "{text: '#{tag.name}', weight: #{tag.tag_count}, link: '#{tag_path(tag)}' }".html_safe }, ', ') } ], {
    width: 960,
    height: 700,
    delay: 0
  }
  );
